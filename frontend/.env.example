# Server-side proxy URL (used by Next.js API routes to reach Laravel)
# This is the ONLY URL you need to set for local development.
API_URL=http://localhost:8000

# Optional server-side road router used only when an admin previews a route.
ROUTING_API_URL=https://router.project-osrm.org

# DO NOT set NEXT_PUBLIC_API_URL — the frontend uses Next.js proxy routes
# (relative paths like /api/auth/login) which forward to Laravel via API_URL.
# Setting NEXT_PUBLIC_API_URL would cause double /api/ in request URLs.

# Sprint 2 — Pusher real-time broadcasting
NEXT_PUBLIC_PUSHER_APP_KEY=your_app_key
NEXT_PUBLIC_PUSHER_APP_CLUSTER=ap1

# CARTO basemap tiles (raster PNG). Get a free key at carto.com/basemaps/apikey
NEXT_PUBLIC_CARTO_API_KEY=your_carto_key

# Reverse geocoder for the admin "Confirm SOS resolution" modal, which turns
# the alert's coordinates into a street/barangay/town line. Server-only, and
# it must point at the /reverse endpoint. SOS coordinates are sent to this
# service, so use an approved one; the route throttles to 1 request/sec and
# caches results to stay within the public OSM Nominatim usage policy.
# Leave unset to skip the lookup (the modal then shows raw coordinates).
NOMINATIM_URL=https://nominatim.openstreetmap.org/reverse
# NOMINATIM_ATTRIBUTION=© OpenStreetMap contributors

# Shared secret with Laravel (FRONTEND_PROXY_SECRET in backend/.env). Lets Laravel's
# per-IP rate limits (login, register, password reset) see each user's real IP
# instead of this server's. Server-only: never prefix with NEXT_PUBLIC_.
# Leave unset to skip forwarding the IP.
# FRONTEND_PROXY_SECRET=your_shared_secret

# Public R2 bucket URL — the same value as R2_PUBLIC_URL in backend/.env.
# Lets next/image serve small, cached copies of profile photos (e.g. the
# User Management table). Leave unset to load them unoptimized.
# NEXT_PUBLIC_R2_PUBLIC_URL=https://your-bucket-id.r2.dev

# Full public URL of the Android APK in the chatco-apk R2 bucket. Enables the
# landing-page download button; leave unset to show "APK coming soon".
# NEXT_PUBLIC_APK_URL=https://your-apk-bucket-id.r2.dev/e-chatco.apk
